makeAbilityButton("Walkspeed", UDim2.new(0, 150, 1, -50), Color3.fromRGB(150, 50, 255), function()
    -- 発動ごとに識別番号を更新
    walkspeedToken += 1
    local myToken = walkspeedToken

    -- 前回のWalkspeedが残っていたら確実に終了
    if activeWalkspeedCleanup then
        activeWalkspeedCleanup()
        activeWalkspeedCleanup = nil
    end

    isWalkspeedActive = true

    local bodyVelocity
    local hitbox
    local touchConn
    local hitRegistered = false
    local finished = false

    local function cleanup(playFailSound)
        if finished then return end
        finished = true

        if touchConn then
            touchConn:Disconnect()
            touchConn = nil
        end

        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end

        if hitbox then
            hitbox:Destroy()
            hitbox = nil
        end

        -- 現在の発動だけが状態を変更できる
        if myToken == walkspeedToken then
            isWalkspeedActive = false
            activeWalkspeedCleanup = nil

            if playFailSound and not hitRegistered then
                local r = math.random()
                local failSound

                if r < 0.33 then
                    failSound = sounds.walkspeedFailed1
                elseif r < 0.66 then
                    failSound = sounds.walkspeedFailed2
                else
                    failSound = sounds.walkspeedFailed3
                end

                failSound:Play()
            end

            -- Walkspeedのループアニメーションだけを終了
            if currentAnim == woloopKF then
                if currentStopper then
                    currentStopper()
                    currentStopper = nil
                end
                currentAnim = nil
            end

            currentState = "Idle"
        end
    end

    activeWalkspeedCleanup = function()
        cleanup(false)
    end

    sounds.walkspeedStart1:Play()
    sounds.walkspeedStart2:Play()

    playAnim(character, wostartKF, false, function()
        -- 古い発動のアニメーション終了処理を無視
        if myToken ~= walkspeedToken then return end
        if not isWalkspeedActive then return end
        if not character or not character.Parent then
            cleanup(false)
            return
        end

        playAnim(character, woloopKF, true)

        -- 元の移動設定を維持
        local direction = character.HumanoidRootPart.CFrame.LookVector
        local speed = 45

        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = direction * speed
        bodyVelocity.MaxForce = Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )
        bodyVelocity.Parent = character.HumanoidRootPart

        hitbox = Instance.new("Part")
        hitbox.Size = Vector3.new(3, 3, 5)
        hitbox.Transparency = 1
        hitbox.CanCollide = false
        hitbox.CFrame =
            character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
        hitbox.Parent = workspace

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = character.HumanoidRootPart
        weld.Part1 = hitbox
        weld.Parent = hitbox

        touchConn = hitbox.Touched:Connect(function(hit)
            if myToken ~= walkspeedToken then return end
            if not isWalkspeedActive or finished then return end
            if hit:IsDescendantOf(character) then return end

            local targetChar = hit:FindFirstAncestorOfClass("Model")
            if not targetChar then return end

            local targetHum = targetChar:FindFirstChild("Humanoid")
            if not targetHum or targetHum.Health <= 0 then return end

            hitRegistered = true

            local dmg = 45
            local isLastHit = targetHum.Health - dmg <= 0

            targetHum:TakeDamage(dmg)

            if isLastHit then
                targetHum.Health = targetHum.MaxHealth
            end

            sounds.walkspeedConnected:Play()

            -- 先に移動処理を終了
            cleanup(false)

            -- 別スキルのアニメーションを誤って止めない
            if myToken == walkspeedToken then
                playAnim(character, woconnectedKF, false, function()
                    if myToken == walkspeedToken then
                        currentState = "Idle"
                    end
                end)
            end
        end)

        -- 元の2.5秒制限を維持
        task.delay(2.5, function()
            if myToken ~= walkspeedToken then return end
            if finished or not isWalkspeedActive then return end

            cleanup(true)
        end)
    end)
end, 0)

