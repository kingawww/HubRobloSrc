                            return
                        end
                    else
                        minionStopper()
                        if npc then npc:Destroy() end
                        return
                    end
                    task.wait(0.1)
                end
                minionStopper()
                if npc then npc:Destroy() end
            end)
        end)
    end
end, 0)

