local UIS = game:GetService("UserInputService") -- anti scrollやドラッグできる場所の指定

local dragging = false
local dragStart
local startPos
local dragTarget

local function EnableDrag(Object, Target)
	Object.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = Target.Position
			dragTarget = Target
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
end

-- ドラッグ可能な場所
EnableDrag(main, main)
EnableDrag(TopBar, main)
EnableDrag(SideBar, main)
EnableDrag(OnOffFormain, OnOffFormain)

UIS.InputChanged:Connect(function(input)

	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then
		local delta = input.Position - dragStart
		dragTarget.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
