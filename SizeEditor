local character
local originalSizes = {}
local originalMotors = {}
local originalWalkSpeed = 16

local function getParts(char)
    return {
        Head = char:FindFirstChild("Head"),
        Torso = char:FindFirstChild("Torso"),
        ["Left Arm"] = char:FindFirstChild("Left Arm"),
        ["Right Arm"] = char:FindFirstChild("Right Arm"),
        ["Left Leg"] = char:FindFirstChild("Left Leg"),
        ["Right Leg"] = char:FindFirstChild("Right Leg"),
        HumanoidRootPart = char:FindFirstChild("HumanoidRootPart")
    }
end

local function saveOriginals(char)
    character = char
    originalSizes = {}
    originalMotors = {}

    local parts = getParts(char)

    for name, part in pairs(parts) do
        if part and part:IsA("BasePart") then
            originalSizes[name] = part.Size
        end
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        originalWalkSpeed = humanoid.WalkSpeed
    end

    for _, partName in ipairs({"Torso", "HumanoidRootPart"}) do
        local part = parts[partName]

        if part then
            for _, motor in ipairs(part:GetChildren()) do
                if motor:IsA("Motor6D") then
                    originalMotors[motor] = {
                        Part0 = motor.Part0,
                        Part1 = motor.Part1,
                        C0 = motor.C0,
                        C1 = motor.C1,
                        Transform = motor.Transform
                    }
                end
            end
        end
    end
end

local function applySize(size)
    if not character or not character.Parent then
        return
    end

    size = tonumber(size)

    if not size or size ~= size
        or size == math.huge or size == -math.huge then
        return
    end

    size = math.clamp(size, MIN_SIZE, MAX_SIZE)
-- Keep higher precision for manually entered values
    size = math.floor(size * 1000000 + 0.5) / 1000000

    local parts = getParts(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    for name, originalSize in pairs(originalSizes) do
        local part = parts[name]

        if part and originalSize then
            part.Size = originalSize * size
        end
    end

    for motor, data in pairs(originalMotors) do
        if motor and motor.Parent then
            motor.Part0 = data.Part0
            motor.Part1 = data.Part1

            motor.C0 = CFrame.new(data.C0.Position * size)
                * (data.C0 - data.C0.Position)

            motor.C1 = CFrame.new(data.C1.Position * size)
                * (data.C1 - data.C1.Position)

            motor.Transform = data.Transform
        end
    end

    if humanoid then
        humanoid.WalkSpeed = originalWalkSpeed -- * size
    end

    csize = size
end

