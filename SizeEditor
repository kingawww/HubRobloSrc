-- Update label
local function updateIndicator()
    indicator.Text = "Current Size: " .. string.format("%.6f", csize):gsub("0+$", ""):gsub("%.$", "")
end

-- Direct size input
indicator.Activated:Connect(function()
    input.Text = ""
    indicator.Visible = false
    input.Visible = true
    input:CaptureFocus()
end)

input.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local value = tonumber(input.Text)
        if value then
            applySize(value)
        end
    end

    input.Visible = false
    indicator.Visible = true
    updateIndicator()
end)

-- Hold-to-repeat support
local holdToken = 0

local function setupHoldButton(button, direction)
    local pressed = false
    local pressInput
    local holdStart = 0

    local function stopHolding()
        pressed = false
        holdToken += 1
    end

    local function changeSize()
        applySize(csize + direction * SIZE_STEP)
        updateIndicator()
    end

    button.InputBegan:Connect(function(inputObject)
        local inputType = inputObject.UserInputType

        if inputType ~= Enum.UserInputType.MouseButton1
            and inputType ~= Enum.UserInputType.Touch then
            return
        end

        if pressed then
            return
        end

        pressed = true
        pressInput = inputObject
        holdStart = os.clock()

        -- First change immediately
        changeSize()

        holdToken += 1
        local myToken = holdToken

        task.spawn(function()
            task.wait(HOLD_DELAY)

            if not pressed or myToken ~= holdToken then
                return
            end

            while pressed and myToken == holdToken do
                changeSize()
                task.wait(REPEAT_INTERVAL)
            end
        end)

        inputObject.Changed:Connect(function()
            if inputObject.UserInputState == Enum.UserInputState.End then
                stopHolding()
            end
        end)
    end)

    -- Stop if the mouse/touch is released outside the button
    UserInputService.InputEnded:Connect(function(inputObject)
        if not pressed then
            return
        end

        if inputObject == pressInput
            or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
            stopHolding()
        end
    end)
end

