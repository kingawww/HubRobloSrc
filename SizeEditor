-- Drag support: mouse and touch
local function makeDraggable(target, handle)
    handle = handle or target

    local dragging = false
    local dragStart
    local startPosition
    local activeInput

    handle.InputBegan:Connect(function(inputObject)
        local inputType = inputObject.UserInputType

        if inputType == Enum.UserInputType.MouseButton1
            or inputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = inputObject.Position
            startPosition = target.Position
            activeInput = inputObject

            inputObject.Changed:Connect(function()
                if inputObject.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    activeInput = nil
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(inputObject)
        if not dragging then
            return
        end

        local isMouseMove =
            inputObject.UserInputType == Enum.UserInputType.MouseMovement

        local isTouchMove =
            inputObject.UserInputType == Enum.UserInputType.Touch
            and activeInput == inputObject

        if isMouseMove or isTouchMove then
            local delta = inputObject.Position - dragStart

            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

